# Application Configuration
APP_NAME="AI Knowledge System"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Docker Compose Host Port Mappings (avoids host port collisions)
APP_HOST_PORT=8001
DB_HOST_PORT=5433

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_knowledge_db

# Asynchronous Database Connection URL
# For local dev outside docker: postgresql+asyncpg://postgres:postgres@localhost:5433/ai_knowledge_db
# Inside docker compose: postgresql+asyncpg://postgres:postgres@db:5432/ai_knowledge_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_knowledge_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Ingestion & Chunking
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
MAX_FILE_SIZE_BYTES=26214400

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8001"]

# Embeddings & Vector Store
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
DEFAULT_SEARCH_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.5

# Optional API-based Embeddings (When EMBEDDING_PROVIDER=openai or api)
# EMBEDDING_API_KEY=your_openai_api_key_here
# EMBEDDING_API_BASE_URL=https://api.openai.com/v1

# LLM Provider Configuration
# Supported providers: ollama (local), openai / api (remote/compatible), mock (testing)
LLM_PROVIDER=ollama
LLM_MODEL=llama3:latest
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=60.0
OLLAMA_BASE_URL=http://localhost:11434

# Optional Remote OpenAI-compatible LLM Settings
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# RAG Pipeline Settings
RAG_DEFAULT_TOP_K=4
RAG_DEFAULT_SIMILARITY_THRESHOLD=0.45
RAG_MAX_CONTEXT_CHARS=8000
