# Application Configuration
APP_NAME="AI Knowledge System"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Docker Compose Host Port Mappings (avoids host port collisions)
APP_HOST_PORT=8001
DB_HOST_PORT=5433

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_knowledge_db

# Asynchronous Database Connection URL
# For local dev outside docker: postgresql+asyncpg://postgres:postgres@localhost:5433/ai_knowledge_db
# Inside docker compose: postgresql+asyncpg://postgres:postgres@db:5432/ai_knowledge_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_knowledge_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Ingestion & Chunking
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
MAX_FILE_SIZE_BYTES=26214400

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8001"]

# Future LLM / Vector Store Providers (To be configured in future phases)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# VECTOR_STORE_TYPE=pgvector
